DATABASE_URL=postgres://materials:materials@localhost:55432/materials
DATABASE_URL_TEST=postgres://materials:materials@localhost:5433/materials_test
# Native pnpm db:local:start creates both databases on 55432 and writes random credentials to .env.
# For an internet server set the exact public HTTPS origin (without a path):
# APP_ORIGIN=https://materials.example.com
VITE_APP_NAME=Материалы
# Printing: install LibreOffice, make soffice available in PATH, or export this
# variable before pnpm dev / pnpm start. Leave unset for automatic discovery.
# MATERIALS_SOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice

# AG Grid Enterprise 35.2.1: place the purchased key in .env.local (gitignored).
VITE_AG_GRID_LICENSE_KEY=
